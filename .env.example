# Dedicated MyAnonamouse session cookie for this MCP.
# Create a SEPARATE session on the MAM Security page (label: "MouseSearch MCP",
# IP or ASN -> ASN, Dynamic Seedbox -> No). Do NOT reuse MouseSearch's mam_id:
# MAM rotates the cookie on every request and the two apps would invalidate
# each other.
MAM_ID=

# Long random token the agent must send as `Authorization: Bearer <token>`.
# Generate with: openssl rand -hex 32
MCP_API_TOKEN=

MAM_API_BASE=https://www.myanonamouse.net
# Same proxy egress as MouseSearch so both present the same VPN IP/ASN.
MAM_PROXY_URL=http://gluetun:8888
MAM_PROXY_ONLY=true
MAM_STATE_FILE=/data/mam-state.json
MAM_REQUEST_TIMEOUT_MS=20000

MOUSESEARCH_URL=http://mousesearch:5000
MOUSESEARCH_TIMEOUT_MS=30000

DEFAULT_CATEGORY=audiobooks
DEFAULT_LANGUAGE=English
MAX_RESULTS=50

MCP_HTTP_BIND=0.0.0.0:8765
MCP_PATH=/mcp
CART_FILE=/data/cart.json
APP_LOG_LEVEL=INFO
